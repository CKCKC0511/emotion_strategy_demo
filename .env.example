# 从火山方舟控制台复制 API Key（不要提交真实密钥）
ARK_API_KEY=

# 可选：本地覆盖 API 基础地址，例如 BytePlus 新加坡区
ARK_BASE=

# 可选：本地覆盖默认模型，例如 seed-sc
DOUBAO_MODEL=

# 可选：自动评测模型，可单独与聊天模型区分
AUTO_EVAL_MODEL=

# 可选：丰荣 / Intro 走 Google Gemini 时在 .env 配置（不要提交真实密钥）
GEMINI_API_KEY=
# 可选：Gemini 模型 ID，例如 gemini-2.0-flash
GEMINI_MODEL=
# 可选：覆盖 Gemini REST 根路径（一般无需修改）
# GEMINI_BASE=https://generativelanguage.googleapis.com/v1beta

# 可选：如果后续接入 Qdrant，再在服务端环境变量里配置
# QDRANT_API_KEY=
